{
  "name": "terra-matriz",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm content:check && vite",
    "content:check": "node tools/index-content.mjs && tsc --noEmit && tsx tools/check-content.ts",
    "build": "pnpm content:check && vite build",
    "preview": "vite preview",
    "test": "node tools/index-content.mjs && tsx --test tests/*.test.ts",
    "test:browser": "node tools/index-content.mjs && tsx --test --test-concurrency=1 tests/browser/*.test.ts"
  },
  "devDependencies": {
    "playwright": "1.62.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
